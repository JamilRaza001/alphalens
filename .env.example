# ── Database ──────────────────────────────────────────────────
# Pooled URL (PgBouncer) — used by app at runtime
NEON_DATABASE_URL=postgresql://USER:PASS@HOST-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct URL — used by Alembic migrations only
NEON_DIRECT_URL=postgresql://USER:PASS@HOST.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── Cloudflare R2 ─────────────────────────────────────────────
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=alphalens-filings
R2_ENDPOINT_URL=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com

# ── LLM ───────────────────────────────────────────────────────
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# ── Embeddings ────────────────────────────────────────────────
JINA_API_KEY=jina_REPLACE_WITH_YOUR_KEY
JINA_MODEL=jina-embeddings-v3
JINA_DIMENSIONS=768
JINA_FREE_TIER_TOKENS=10000000

# ── Reranker (in-process) ─────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── AWS ───────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA_REPLACE_WITH_DEPLOYER_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_DEPLOYER_SECRET
AWS_DEFAULT_REGION=ap-southeast-1
LAMBDA_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/alphalens-lambda-role
ECR_REGISTRY=YOUR_ACCOUNT_ID.dkr.ecr.ap-southeast-1.amazonaws.com
ECR_REPO_NAME=alphalens-agent

# ── Observability ─────────────────────────────────────────────
SENTRY_DSN=https://KEY@ORG.ingest.sentry.io/PROJECT_ID
SENTRY_ORG=alphalens
SENTRY_PROJECT=javascript-nextjs
OPIK_API_KEY=REPLACE_WITH_YOUR_OPIK_KEY
OPIK_WORKSPACE=alphalens

# ── App ───────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── SEC EDGAR ────────────────────────────────────────────────
SEC_EDGAR_USER_AGENT=Your Name your.email@example.com
