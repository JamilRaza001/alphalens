# Base URL of the S18 FastAPI server started by scripts/run_api.py.
# Copy this file to .env.local, which is git-ignored (AC12).
#
# Keep the loopback IP form rather than the hostname form. app.py's CORS list
# allows both page origins, but mixing the two forms between the page and the
# API it calls is the G8 trap.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
